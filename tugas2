    expr = "((8*5)+(9/(7-4)))"

    print("Ekspresi:")
    print(expr)

    # buat object
    sorter = ExprHeapSorter(expr)

    # evaluasi ekspresi
    result = sorter.parse_and_evaluate()

    print("\nHasil evaluasi ekspresi:")
    print(result)

    # data array
    data = [45, 12, 78, 3, 56, 23, 89, 1]

    print("\nArray sebelum heapsort:")
    print(data)

    # heapsort
    sorted_data = sorter.heapsort_inplace(data)

    print("\nArray setelah heapsort:")
    print(sorted_data)

    # cek complete tree
    is_complete = sorter.is_complete_tree(sorted_data)

    print("\nApakah array memenuhi complete binary tree?")
    print(is_complete)

